#!/bin/sh
set -eu
curl --fail --location --retry 3 --proto '=https' --proto-redir '=https' \
 https://download.teamviewer.com/download/linux/teamviewer-host_amd64.deb -o /tmp/teamviewer-host.deb
[ "$(dpkg-deb -f /tmp/teamviewer-host.deb Architecture)" = amd64 ]
[ "$(dpkg-deb -f /tmp/teamviewer-host.deb Package)" = teamviewer-host ]
apt-get update
apt-get install -y /tmp/teamviewer-host.deb
rm /tmp/teamviewer-host.deb
systemctl enable ssh.service NetworkManager.service teamviewerd.service ibs-remote.service
rm -f /etc/ssh/ssh_host_*key /etc/ssh/ssh_host_*key.pub
