#!/bin/sh
set -eu
# Same package version and daemon binary as the working NAS Rescue PXE ISO.
package=/tmp/teamviewer-host.deb
expected=31a633b8f3ebf180849f56ae0edd2a9c4abc757472668455dc73e08c3b975b4f
printf '%s  %s\n' "$expected" "$package" | sha256sum --check
[ "$(dpkg-deb -f "$package" Architecture)" = amd64 ]
[ "$(dpkg-deb -f "$package" Package)" = teamviewer-host ]
[ "$(dpkg-deb -f "$package" Version)" = 15.82.6 ]
apt-get update
apt-get install -y --allow-downgrades "$package"
apt-mark hold teamviewer-host
rm "$package"
# As in Rescue: generate a fresh identity only when the live boots.
find /etc/teamviewer -maxdepth 1 -type f -name global.conf -delete
if [ -d /var/log/teamviewer15 ]; then find /var/log/teamviewer15 -type f -delete; fi
systemctl enable ssh.service NetworkManager.service teamviewerd.service ibs-remote.service
rm -f /etc/ssh/ssh_host_*key /etc/ssh/ssh_host_*key.pub
