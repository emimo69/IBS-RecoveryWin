#!/bin/sh
set -eu
[ "$(id -un)" = admin ] || exit 0
xdg-user-dirs-update
desktop=$(xdg-user-dir DESKTOP)
[ -n "$desktop" ] && [ "$desktop" != "$HOME" ]
mkdir -p "$desktop"
launcher="$desktop/teamviewer-assistenza.desktop"
install -m 0755 /usr/share/ibs/teamviewer-assistenza.desktop "$launcher"
checksum=$(sha256sum "$launcher" | cut -d ' ' -f1)
for attempt in $(seq 1 30); do
    if gio set -t string "$launcher" metadata::xfce-exe-checksum "$checksum"; then
        touch "$launcher"
        exit 0
    fi
    sleep 1
done
printf '%s\n' 'IBS: impossibile rendere attendibile il launcher TeamViewer.' >&2
exit 1
