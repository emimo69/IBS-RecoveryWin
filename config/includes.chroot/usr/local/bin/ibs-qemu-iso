#!/bin/bash
set -euo pipefail

ISO=$(/usr/local/bin/ibs-iso-select) || exit $?
[ -n "$ISO" ] || exit 0

if [ ! -f "$ISO" ]; then
    zenity --error --text="ISO non disponibile: $ISO"
    exit 1
fi

BOOT=$(zenity --list --radiolist \
    --title="IBS-RecoveryWin - Modalità avvio" \
    --width=480 --height=260 \
    --column="Seleziona" --column="Firmware" \
    TRUE "UEFI (OVMF)" \
    FALSE "BIOS Legacy") || exit 0

[ -n "$BOOT" ] || exit 0

WORKDIR=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/ibs-qemu-iso.XXXXXXXX")
trap 'rm -rf -- "$WORKDIR"' EXIT
LOGDIR="${XDG_STATE_HOME:-$HOME/.local/state}/ibs-recoverywin"
mkdir -p "$LOGDIR"
LOG=$(mktemp "$LOGDIR/winre-XXXXXXXX.log")
# No automatic reboot: keep the failure visible for WinRE diagnosis.
RAM_KB=$(awk '/MemTotal:/ {print $2}' /proc/meminfo)

if (( RAM_KB >= 60000000 )); then
    VM_RAM=24576
elif (( RAM_KB >= 30000000 )); then
    VM_RAM=16384
elif (( RAM_KB >= 15000000 )); then
    VM_RAM=8192
else
    VM_RAM=4096
fi

ARGS=(
    -machine q35
    -m "$VM_RAM"
    -smp 2
    -boot "order=d,menu=on"
    -no-reboot
    -cdrom "$ISO"
    -vga std
    -nic "user,model=e1000"
)

if [ -r /dev/kvm ] && [ -w /dev/kvm ]; then
    ARGS+=(-accel kvm)
else
    ARGS+=(-accel tcg)
fi

if [[ "$BOOT" == "UEFI (OVMF)" ]]; then
    OVMF_CODE="/usr/share/OVMF/OVMF_CODE_4M.fd"
    OVMF_VARS="/usr/share/OVMF/OVMF_VARS_4M.fd"

    if [ ! -f "$OVMF_CODE" ] || [ ! -f "$OVMF_VARS" ]; then
        zenity --error --text="Firmware OVMF non trovato."
        exit 1
    fi

    VARS="$WORKDIR/ovmf-vars.fd"
    cp "$OVMF_VARS" "$VARS"

    ARGS+=(
        -drive "if=pflash,format=raw,readonly=on,file=$OVMF_CODE"
        -drive "if=pflash,format=raw,file=${VARS//,/,,}"
    )
fi

# ISO is attached as a read-only CD-ROM. Only the private VARS copy is writable.
printf 'Firmware: %s\nISO: %s\n' "$BOOT" "$ISO" >"$LOG"
if qemu-system-x86_64 "${ARGS[@]}" 2>>"$LOG"; then
    zenity --info --text="Sessione terminata. Se WinRE si è arrestato, consultare il log: $LOG" || true
else
    STATUS=$?
    zenity --error --text="QEMU non riuscito (codice $STATUS). Log: $LOG" || true
    exit "$STATUS"
fi
