#!/bin/bash
set -euo pipefail

DISK="${1:-}"
MODE="${2:-uefi}"

case "$MODE" in
    uefi|legacy) ;;
    *) echo "Firmware non valido" >&2; exit 1 ;;
esac

# Ricontrolla il disco immediatamente prima dell'apertura.
/usr/local/sbin/ibs-disk-check "$DISK" >/dev/null || {
    echo "Disco non autorizzato: $DISK" >&2
    exit 1
}

DISK=$(readlink -f "$DISK")

# Verifica il dispositivo e mostra i dati identificativi.
lsblk -dn -o NAME,SIZE,MODEL,SERIAL "$DISK"

WORKDIR=$(mktemp -d /tmp/ibs-qemu-direct.XXXXXXXX)
cleanup() {
    rm -rf -- "$WORKDIR"
}
trap cleanup EXIT

ARGS=(
    -machine q35
    -m 4096
    -smp 2
    -drive "file=$DISK,format=raw,if=ide,cache=none"
    -nic user,model=e1000
    -vga std
)

if [ -e /dev/kvm ]; then
    ARGS+=(-accel kvm)
else
    ARGS+=(-accel tcg)
fi

if [ "$MODE" = "uefi" ]; then
    CODE="/usr/share/OVMF/OVMF_CODE_4M.fd"
    VARS="/usr/share/OVMF/OVMF_VARS_4M.fd"

    [ -f "$CODE" ] && [ -f "$VARS" ] || exit 1

    cp "$VARS" "$WORKDIR/ovmf-vars.fd"

    ARGS+=(
        -drive "if=pflash,format=raw,readonly=on,file=$CODE"
        -drive "if=pflash,format=raw,file=$WORKDIR/ovmf-vars.fd"
    )
fi

# Evita una seconda VM sullo stesso disco, quando possibile.
exec 9>"$WORKDIR/session.lock"
flock -n 9 || exit 1

qemu-system-x86_64 "${ARGS[@]}"
