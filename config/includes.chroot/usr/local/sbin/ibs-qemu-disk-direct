#!/bin/bash
set -euo pipefail
DISK=${1:-}
MODE=${2:-uefi}
SESSION_KIND=direct
# shellcheck source=config/includes.chroot/usr/local/lib/ibs-recoverywin/qemu-session.sh
source /usr/local/lib/ibs-recoverywin/qemu-session.sh
ibs_session_init
zenity --question --width=700 --title="Conferma scrittura diretta" \
    --text="ATTENZIONE: Windows potrà modificare realmente partizioni, dati ed EFI.\n\n$IDENTITY\n\nDisco: $DISK\n\nConfermi la scrittura su questo disco?" || exit 0
ibs_revalidate
WORKDIR=$(mktemp -d /tmp/ibs-qemu-direct.XXXXXXXX)
trap 'rm -rf -- "$WORKDIR"' EXIT
ibs_qemu_args
# Pin the validated block device. QEMU opens the inherited FD, not a replaceable path.
exec 8<>"$DISK"
[[ "$(stat -Lc '%t:%T' /proc/self/fd/8)" == "$(stat -Lc '%t:%T' "$DISK")" ]] || exit 1
ibs_revalidate
ARGS+=(-add-fd "fd=8,set=1,opaque=physical-disk" -drive "file=/dev/fdset/1,format=raw,if=ide,cache=none")
qemu-system-x86_64 "${ARGS[@]}"
