#!/bin/bash
set -euo pipefail
DEST=/mnt/ibs-ventoy
mkdir -p "$DEST"
if mountpoint -q "$DEST"; then
    SOURCE=$(findmnt -rn -M "$DEST" -o SOURCE)
    [[ "$SOURCE" != /dev/mapper/ventoy ]] || { echo "La destinazione è il supporto Live, operazione annullata." >&2; exit 1; }
    printf '%s\n' "$DEST"
    exit 0
fi
while IFS= read -r DEV; do
    LABEL=$(lsblk -dnro LABEL "$DEV")
    [[ "${LABEL,,}" == ventoy ]] || continue
    PARENT=$(lsblk -dnro PKNAME "$DEV")
    [[ -n "$PARENT" ]] || continue
    [[ "$(lsblk -dnro TRAN "/dev/$PARENT")" == usb ]] || continue
    MOUNTED=$(findmnt -rn -S "$DEV" -o TARGET || true)
    if [[ -n "$MOUNTED" ]]; then
        printf '%s\n' "$MOUNTED"
        exit 0
    fi
    if mount -o ro,nosuid,nodev,noexec "$DEV" "$DEST"; then
        printf '%s\n' "$DEST"
        exit 0
    fi
    # Ventoy's live DM mapping may hold the partition exclusively. A separate
    # read-only loop view avoids removing or modifying that boot mapping.
    LOOP=$(losetup --find --show --read-only "$DEV") || continue
    if mount -o ro,nosuid,nodev,noexec "$LOOP" "$DEST"; then
        printf '%s\n' "$DEST"
        exit 0
    fi
    losetup -d "$LOOP"
done < <(lsblk -rnp -o NAME,TYPE | awk '$2=="part"{print $1}')
echo "ISO Ventoy non accessibili. Il supporto Live non è stato modificato; scegliere una ISO locale o il NAS." >&2
exit 1
