#!/bin/bash
set -euo pipefail
MODE=${1:-uefi}
KIND=${2:-protected}
case "$MODE" in uefi|legacy) ;; *) echo "Firmware non valido" >&2; exit 1 ;; esac
COMMANDS=(qemu-system-x86_64 blockdev lsblk flock zenity)
if [[ "$KIND" == protected ]]; then COMMANDS+=(qemu-img dmsetup); fi
for cmd in "${COMMANDS[@]}"; do
    command -v "$cmd" >/dev/null || { echo "Comando mancante: $cmd" >&2; exit 1; }
done
if [[ "$KIND" == protected && ! -e /dev/mapper/control ]]; then
    echo "Device Mapper non disponibile: impossibile garantire la protezione." >&2; exit 1
fi
if [[ "$MODE" == uefi ]]; then
    for file in /usr/share/OVMF/OVMF_{CODE,VARS}_4M.fd; do
        [[ -r "$file" ]] || { echo "Firmware UEFI mancante: $file" >&2; exit 1; }
    done
fi
