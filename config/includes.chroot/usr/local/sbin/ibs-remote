#!/bin/bash
set -eu
export LC_ALL=C
info=/mnt/teamviewer.txt
publish() {
    printf '%s\n' "$1" > "$info.tmp"
    chown root:admin "$info.tmp"
    chmod 0640 "$info.tmp"
    mv "$info.tmp" "$info"
}
# EXIT also handles unexpected failures under set -e. Never print credentials.
error_message='TeamViewer: errore imprevisto durante la preparazione. Consultare journalctl -u ibs-remote e riavviare il servizio.'
on_exit() {
    rc=$?
    trap - EXIT HUP INT TERM
    if [ "$rc" -ne 0 ]; then
        set +e
        publish "$error_message" 2>/dev/null
    fi
    exit "$rc"
}
trap on_exit EXIT
trap 'error_message="TeamViewer: preparazione interrotta; riavviare il servizio."; exit 1' HUP INT TERM
install -d -m 0755 /mnt
# Clear previous session credentials before any operation that can fail.
publish 'TeamViewer: inizializzazione in corso, credenziali non ancora disponibili.'
# Accept the license and restart the system daemon like NAS Rescue PXE 0.6.6.
# Start the user GUI only after the daemon ID and personal password are ready.
teamviewer license accept >/dev/null 2>&1 || true
systemctl restart teamviewerd.service
# Attende daemon TeamViewer
for I in $(seq 1 30)
do
    systemctl is-active --quiet teamviewerd.service && break
    sleep 2
done

# ----------------------------------------------------------
# Attende la sessione grafica XFCE di admin
# ----------------------------------------------------------

XPID=""

for I in $(seq 1 120)
do
    XPID=$(pgrep -u admin -n xfce4-session 2>/dev/null || true)

    [ -n "$XPID" ] && break

    sleep 2
done

# ----------------------------------------------------------
# Legge l'ambiente della sessione XFCE per avviare la GUI in seguito
# ----------------------------------------------------------

if [ -n "$XPID" ]
then
    DISPLAY_VAR=$(
        tr '\0' '\n' < /proc/$XPID/environ 2>/dev/null |
        sed -n 's/^DISPLAY=//p' |
        head -1
    )

    XAUTH_VAR=$(
        tr '\0' '\n' < /proc/$XPID/environ 2>/dev/null |
        sed -n 's/^XAUTHORITY=//p' |
        head -1
    )

    DBUS_VAR=$(
        tr '\0' '\n' < /proc/$XPID/environ 2>/dev/null |
        sed -n 's/^DBUS_SESSION_BUS_ADDRESS=//p' |
        head -1
    )

    XDG_RUNTIME=$(
        tr '\0' '\n' < /proc/$XPID/environ 2>/dev/null |
        sed -n 's/^XDG_RUNTIME_DIR=//p' |
        head -1
    )

fi

# ----------------------------------------------------------

if [ -z "$XPID" ]; then
    error_message='TeamViewer: sessione XFCE admin non disponibile.'
    exit 1
fi
id=''
for attempt in $(seq 1 120); do
    if output=$(teamviewer info 2>/dev/null); then
        id=$(printf '%s\n' "$output" | awk '
            BEGIN { esc = sprintf("%c", 27) }
            {
                # Strip ANSI CSI colors and CR used by the CLI.
                gsub(esc "\\[[0-?]*[ -/]*[@-~]", "")
                gsub(/\r/, "")
                if ($0 ~ /^[ \t]*TeamViewer ID[ \t]*:/) {
                    count++
                    sub(/^[ \t]*TeamViewer ID[ \t]*:[ \t]*/, "")
                    sub(/[ \t]*$/, "")
                    if ($0 ~ /^[0-9]+([ \t]+[0-9]+)*$/) {
                        gsub(/[ \t]/, "")
                        if ($0 ~ /[1-9]/) value = $0
                    }
                }
            }
            END { if (count == 1 && value != "") print value }
        ')
    fi

    [ -z "$id" ] || break
    sleep 5
done
if [ -z "$id" ]; then
    error_message='TeamViewer: ID non disponibile; controllare la connessione Internet.'
    exit 1
fi
# Set the password LAST, as in the working Rescue ISO.
ready=false
for attempt in $(seq 1 30); do
    candidate=$(openssl rand -base64 6)
    candidate=$(printf '%s' "$candidate" | tr '+/' 'AZ')
    if [[ "$candidate" =~ [A-Z] ]] && [[ "$candidate" =~ [a-z] ]] && [[ "$candidate" =~ [0-9] ]]; then
        if password_result=$(teamviewer passwd "$candidate" 2>&1) &&
           printf '%s\n' "$password_result" | grep -qx 'ok'; then
            password=$candidate
            ready=true
            break
        fi
    fi
done
if [ "$ready" != true ]; then
    error_message='TeamViewer: configurazione password fallita. Consultare journalctl -u ibs-remote.'
    exit 1
fi
# A GUI opened while TeamViewer is still creating its ID can cache the
# "daemon not running" window. Reattach it after the daemon and password are ready.
pkill -u admin -f '/opt/teamviewer/tv_bin/TeamViewer' \
    >/dev/null 2>&1 || true
sleep 2
runuser -u admin -- env \
    HOME=/home/admin \
    USER=admin \
    LOGNAME=admin \
    DISPLAY="${DISPLAY_VAR:-:0}" \
    XAUTHORITY="${XAUTH_VAR:-/home/admin/.Xauthority}" \
    DBUS_SESSION_BUS_ADDRESS="${DBUS_VAR:-}" \
    XDG_RUNTIME_DIR="${XDG_RUNTIME:-/run/user/1000}" \
    /opt/teamviewer/tv_bin/TeamViewer \
    >/run/ibs-teamviewer-gui.log 2>&1 &
sleep 5
ips=$(ip -o -4 addr show scope global | awk '{print $4}' | cut -d/ -f1 | paste -sd ',' -)
if [ -z "$ips" ]; then
    ips=$(ip -o -6 addr show scope global | awk '{print $4}' | cut -d/ -f1 | paste -sd ',' -)
fi
if [ -z "$ips" ]; then
    error_message='TeamViewer: indirizzo IP locale non disponibile.'
    exit 1
fi
publish "TeamViewer ID: $id
Password: $password
IP locale: $ips"
exit 0
