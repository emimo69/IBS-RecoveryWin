#!/bin/sh
set -eu
export LC_ALL=C
info=/mnt/teamviewer.txt
publish() {
    printf '%s\n' "$1" > "$info.tmp"
    chown root:admin "$info.tmp"
    chmod 0640 "$info.tmp"
    mv "$info.tmp" "$info"
}
# EXIT also handles unexpected failures under set -e. Never print credentials.
error_message='TeamViewer: errore imprevisto durante la preparazione. Consultare journalctl -u ibs-remote e riavviare il servizio.'
on_exit() {
    rc=$?
    trap - EXIT HUP INT TERM
    if [ "$rc" -ne 0 ]; then
        set +e
        publish "$error_message" 2>/dev/null
    fi
    exit "$rc"
}
trap on_exit EXIT
trap 'error_message="TeamViewer: preparazione interrotta; riavviare il servizio."; exit 1' HUP INT TERM
install -d -m 0755 /mnt
# Clear previous session credentials before any operation that can fail.
publish 'TeamViewer: inizializzazione in corso, credenziali non ancora disponibili.'
password=$(openssl rand -hex 8)
# TeamViewer requires acceptance of its license before unattended use.
# Keep any existing vendor settings intact.
systemctl stop teamviewerd.service
install -d -m 0755 /etc/teamviewer
conf=/etc/teamviewer/global.conf
touch "$conf"
if ! grep -q '^\[int32\] EulaAccepted = 1$' "$conf"; then
    sed -i '/^\[int32\] EulaAccepted = /d' "$conf"
    printf '\n[int32] EulaAccepted = 1\n' >> "$conf"
fi
systemctl start teamviewerd.service
ready=false
for attempt in $(seq 1 60); do
    if password_result=$(teamviewer passwd "$password" 2>&1) &&
       printf '%s\n' "$password_result" | grep -qx 'ok'; then
        ready=true
        break
    fi
    sleep 3
done
if [ "$ready" != true ]; then
    error_message='TeamViewer: configurazione password fallita. Consultare journalctl -u ibs-remote.'
    exit 1
fi
for attempt in $(seq 1 60); do
    id=''
    # Capture the command exit status BEFORE parsing; safe with set -e.
    if output=$(teamviewer info 2>/dev/null); then
        id=$(printf '%s\n' "$output" | awk '
            BEGIN { esc = sprintf("%c", 27) }
            {
                # Strip ANSI CSI colors and CR used by the CLI.
                gsub(esc "\\[[0-?]*[ -/]*[@-~]", "")
                gsub(/\r/, "")
                if ($0 ~ /^[ \t]*TeamViewer ID[ \t]*:/) {
                    count++
                    sub(/^[ \t]*TeamViewer ID[ \t]*:[ \t]*/, "")
                    sub(/[ \t]*$/, "")
                    if ($0 ~ /^[0-9]+([ \t]+[0-9]+)*$/) {
                        gsub(/[ \t]/, "")
                        if ($0 ~ /[1-9]/) value = $0
                    }
                }
            }
            END { if (count == 1 && value != "") print value }
        ')
    fi
    if [ -n "$id" ] && [ "$id" != 0 ]; then
        ips=$(ip -o -4 addr show scope global | awk '{print $4}' | cut -d/ -f1 | paste -sd ',' -)
        if [ -z "$ips" ]; then
            ips=$(ip -o -6 addr show scope global | awk '{print $4}' | cut -d/ -f1 | paste -sd ',' -)
        fi
        if [ -z "$ips" ]; then
            publish 'TeamViewer: indirizzo IP locale non disponibile; credenziali non ancora pronte.'
            sleep 1
            continue
        fi
        publish "TeamViewer ID: $id
Password: $password
IP locale: $ips"
        exit 0
    fi
    sleep 1
done
error_message='TeamViewer: ID o indirizzo IP locale non disponibile. Controllare rete e journalctl -u ibs-remote; riavviare il servizio per riprovare.'
exit 1
