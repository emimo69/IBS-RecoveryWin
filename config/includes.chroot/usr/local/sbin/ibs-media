#!/usr/bin/env python3
import json
import os
import sys
sys.path.insert(0,'/usr/local/lib/ibs-recovery')
from media import MediaError,guest_guard,read_inventory,ventoy_candidates,fingerprint,mount_nas,mount_ventoy
from vm import launch,kvm_available,disk_candidates,disk_reasons,ensure_live_medium,OVMF_CODE,OVMF_VARS
os.umask(0o077)
try:
    guest_guard()
    action=sys.argv[1] if len(sys.argv)>1 else ''
    if action=='ventoy-list' and len(sys.argv)==2:
        result=[{'token':fingerprint(r),'name':r['name'],'label':r.get('label') or 'Ventoy dati','size':r['size']} for r in ventoy_candidates(read_inventory())]
    elif action=='capabilities' and len(sys.argv)==2:
        result={'kvm':kvm_available(),'ovmf':OVMF_CODE.is_file() and OVMF_VARS.is_file()}
    elif action=='disks' and len(sys.argv)==2:
        ensure_live_medium()
        rows=read_inventory()
        result=[{'token':fingerprint(r),'name':r['name'],'size':r['size'],'model':r.get('model') or 'Disco'} for r in disk_candidates(rows)]
    elif action=='launch' and len(sys.argv)==3:
        result=launch(json.loads(sys.argv[2]))
    elif action=='nas' and len(sys.argv)==2:
        result={'path':mount_nas()}
    elif action=='ventoy' and len(sys.argv)==3:
        result={'path':mount_ventoy(sys.argv[2])}
    else:
        raise MediaError('Azione non valida.')
    print(json.dumps(result))
except (MediaError,OSError,ValueError,KeyError) as exc:
    print(json.dumps({'error':str(exc)}));sys.exit(1)
