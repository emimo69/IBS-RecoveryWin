<?xml version="1.0" encoding="UTF-8"?>
<policyconfig>
  <action id="it.ibs.recoverywin.ssh">
    <description>Configura IBS ssh</description>
    <message>Autenticarsi per configurare IBS</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/ibs-ssh-enable</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
