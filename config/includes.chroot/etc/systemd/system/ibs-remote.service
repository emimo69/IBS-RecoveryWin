[Unit]
Description=IBS credenziali di assistenza live
Wants=network-online.target teamviewerd.service
# The vendor passwd command stops/starts the daemon: do not propagate its stop.
After=live-config.service network-online.target teamviewerd.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/ibs-remote
RemainAfterExit=yes
TimeoutStartSec=1200
Restart=on-failure
RestartSec=10
UMask=0077

[Install]
WantedBy=multi-user.target
