[Unit]
Description=IBS controllo assistito incarichi GitHub
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/ibs-recoverywin-1.0
ExecStart=/opt/ibs-recoverywin-1.0/automation/task-watch unattended
UMask=0077
NoNewPrivileges=true
# Codex invokes its own workspace-write sandbox; the outer read-only mounts
# make bubblewrap fail before Codex can start. Keep this as an unprivileged
# user service with NoNewPrivileges, PrivateTmp and Codex's inner sandbox.
PrivateTmp=true
TimeoutStartSec=2h 2min
TimeoutStopSec=20
KillMode=control-group
StandardOutput=null
StandardError=null
